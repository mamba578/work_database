<Window x:Class="AdminPanel_project.AnaliticalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:AdminPanel_project"
        mc:Ignorable="d"
        Icon="/Foto/Icon.ico"
        Title="Azure"
        Height="750"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Шапка (Баннер) -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource BannerBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Панель аналитики Azure" Style="{StaticResource BannerTitleStyle}"/>

                <!-- Кнопка "Назад" (убрали костыльный Border из ресурсов) -->
                <Button Grid.Column="1"
                        Content="Назад"
                        Style="{StaticResource InvertedRoundedButtonStyle}"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        Click="BackBt_Click"/>
            </Grid>
        </Border>

        <!-- График 1: Динамика выручки -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ChartContainerStyle}">
            <DockPanel>
                <TextBlock Text="Динамика выручки (руб.)" Style="{StaticResource ChartTitleStyle}"/>
                <lvc:CartesianChart Name="RevenueLineChart"/>
            </DockPanel>
        </Border>

        <!-- График 2: Продажи по категориям -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ChartContainerStyle}">
            <DockPanel>
                <TextBlock Text="Продажи по категориям" Style="{StaticResource ChartTitleStyle}"/>
                <lvc:PieChart Name="CategoriesPieChart" LegendPosition="Right"/>
            </DockPanel>
        </Border>

        <!-- График 3: Топ-5 продаваемых товаров -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ChartContainerStyle}">
            <DockPanel>
                <TextBlock Text="Топ-5 продаваемых товаров (шт.)" Style="{StaticResource ChartTitleStyle}"/>
                <lvc:CartesianChart Name="TopProductsChart"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>