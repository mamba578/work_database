<Window x:Class="AdminPanel_project.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminPanel_project"
        mc:Ignorable="d"
        Icon="/Foto/Icon.ico"
        Title="Azure"
        Height="750"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Сайдбар -->
        <Border Background="#6F8AA6" Grid.Column="0">
            <StackPanel Margin="20">
                <TextBlock Text="Админ панель" Style="{StaticResource SidebarHeaderStyle}"/>

                <Button x:Name="ProductsBt" Content="Товары" Style="{StaticResource SidebarButtonStyle}" Click="ProductsBt_Click"/>
                <Button x:Name="PointsBt" Content="Пункты выдачи" Style="{StaticResource SidebarButtonStyle}" Click="PointsBt_Click"/>
                <Button x:Name="OrdersBt" Content="Заказы" Style="{StaticResource SidebarButtonStyle}" Click="OrdersBt_Click"/>
                <Button x:Name="AnaliticBt" Content="Аналитика" Style="{StaticResource SidebarButtonStyle}" Click="AnaliticBt_Click"/>

                <Button x:Name="ExitBt" Content="Выйти" Style="{StaticResource DangerButtonStyle}" Height="45" Margin="0,40,0,0" Click="ExitBt_Click"/>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="90"/>
            </Grid.RowDefinitions>

            <!-- Шапка контента -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Управление товарами" Style="{StaticResource PageTitleStyle}"/>

                <!-- Комбобокс для фильтрации по категории -->
                <ComboBox x:Name="FilterCategoryCb" 
                          Grid.Column="1" 
                          Style="{StaticResource FormComboBoxStyle}" 
                          Margin="0,0,15,0"
                          SelectionChanged="FilterCategoryCb_SelectionChanged"/>

                <!-- Поисковая строка -->
                <TextBox x:Name="SearchTb" 
                         Grid.Column="2" 
                         Style="{StaticResource RoundedTextBoxStyle}" 
                         TextChanged="SearchTb_TextChanged"/>
            </Grid>

            <!-- Список товаров -->
            <ListBox x:Name="ProductsListBox"
                     Grid.Row="1"
                     Margin="0,20,0,20"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Background="Transparent"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Карточка товара -->
                        <Border Style="{StaticResource ProductCardStyle}" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Статус -->
                                    <RowDefinition Height="150"/>
                                    <!-- Картинка (НОВАЯ СТРОКА) -->
                                    <RowDefinition Height="*"/>
                                    <!-- Название и количество -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Категория и бренд -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Цена -->
                                </Grid.RowDefinitions>

                                <!-- Статус -->
                                <Border Grid.Row="0" Style="{StaticResource DynamicStatusBadgeStyle}">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource DynamicStatusTextStyle}"/>
                                </Border>

                                <!-- Фотография товара -->
                                <Image Grid.Row="1" 
                                        Source="{Binding Photo}" 
                                        Stretch="Uniform" 
                                        Margin="0,10,0,10"/>

                                <!-- Название и количество (Сдвинули на Grid.Row="2") -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource ProductTitleStyle}"/>
                                    <TextBlock Text="{Binding Path=Quantity, StringFormat='В наличии: {0} шт.'}" Style="{StaticResource ProductStockStyle}"/>
                                </StackPanel>

                                <!-- Категория и бренд (Сдвинули на Grid.Row="3") -->
                                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Category, StringFormat='Категория: {0}'}" Style="{StaticResource ProductDetailStyle}"/>
                                    <TextBlock Text="{Binding Brand, StringFormat='Бренд: {0}'}" Style="{StaticResource ProductDetailStyle}"/>
                                </StackPanel>

                                <!-- Цена (Сдвинули на Grid.Row="4") -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Price, StringFormat='{}{0} ₽'}" Style="{StaticResource ProductPriceStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Нижняя панель действий -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <Button Content="Добавить" Margin="10" Style="{StaticResource PrimaryButtonStyle}" Click="AddBt_Click"/>

                <Button Grid.Column="1" Content="Редактировать" Margin="10" Style="{StaticResource WarningButtonStyle}" Click="EditBt_Click"/>

                <Button Grid.Column="2" Content="Удалить" Margin="10" Style="{StaticResource DangerButtonStyle}" Click="DeleteBt_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>