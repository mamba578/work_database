<Window x:Class="AdminPanel_project.Models.PointWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminPanel_project.Models"
        mc:Ignorable="d"
        Icon="/Foto/Icon.ico"
        Title="Azure"
        Height="750"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF2F5">

    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Grid.Row="0" Style="{StaticResource BannerBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Пункты выдачи" Style="{StaticResource BannerTitleStyle}"/>

                <Button Grid.Column="1"
                        Content="Назад"
                        Style="{StaticResource InvertedRoundedButtonStyle}"
                        Margin="0,0,20,0"
                        Click="BackBt_Click"/>
            </Grid>
        </Border>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <Grid Grid.Row="1" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- ТАБЛИЦА -->
            <DataGrid x:Name="PickUpPointsGrid"
                      Grid.Column="0"
                      Margin="0,0,20,0"
                      Style="{StaticResource StandardDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="150"/>
                    <DataGridTextColumn Header="Улица" Binding="{Binding Street}" Width="*"/>
                    <DataGridTextColumn Header="Дом" Binding="{Binding HomeNumber}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ФОРМА -->
            <Border Grid.Column="1" Style="{StaticResource FormContainerStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ЗАГОЛОВОК ФОРМЫ -->
                        <TextBlock Text="Новый пункт" Style="{StaticResource FormTitleStyle}"/>

                        <!-- ГОРОД -->
                        <TextBlock Text="Город" Style="{StaticResource FormLabelStyle}" Margin="5,0,0,5"/>
                        <TextBox x:Name="CityTb" Style="{StaticResource FormTextBoxStyle}" MaxLength="100"/>

                        <!-- УЛИЦА -->
                        <TextBlock Text="Улица" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="StreetTb" Style="{StaticResource FormTextBoxStyle}" MaxLength="150"/>

                        <!-- НОМЕР ДОМА -->
                        <TextBlock Text="Номер дома" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="HomeNumberTb" Style="{StaticResource FormTextBoxStyle}" MaxLength="10"/>

                        <!-- КНОПКА РЕГИСТРАЦИИ -->
                        <Button x:Name="AddPointBt"
                                Content="Зарегистрировать"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="48"
                                FontSize="15"
                                Margin="0,30,0,0"
                                Click="AddPointBt_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>