<Window x:Class="AdminPanel_project.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminPanel_project"
        mc:Ignorable="d"
        Icon="/Foto/Icon.ico"
        Title="Azure"
        Height="752"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА (Используем стили из окна аналитики) -->
        <Border Style="{StaticResource BannerBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Управление заказами" Style="{StaticResource BannerTitleStyle}"/>

                <!-- Кнопка "Назад" без вложенных Border -->
                <Button Grid.Column="1"
                        Content="Назад"
                        Style="{StaticResource InvertedRoundedButtonStyle}"
                        Margin="0,0,20,0"
                        Click="BackBt_Click"/>
            </Grid>
        </Border>

        <!-- ТАБЛИЦА -->
        <!-- ТАБЛИЦА (Обернута в белую панель с закруглениями) -->
        <Border Grid.Row="1" Background="White" CornerRadius="25" Margin="20,0,20,20" Padding="10">
            <DataGrid x:Name="OrdersGrid" Style="{StaticResource StandardDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="150"/>
                    <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Дата доставки" Binding="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Адрес" Binding="{Binding PointAddress}" Width="*"/>
                    <DataGridTextColumn Header="Оплата" Binding="{Binding PaymentType}" Width="130"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat='{}{0} ₽'}" Width="100"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- НИЖНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="2" Style="{StaticResource BottomActionBorderStyle}">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- СТАТУС (Используем стиль форм, но локально меняем высоту на 45) -->
                <ComboBox x:Name="StatusCb"
                          Style="{StaticResource FormComboBoxStyle}"
                          Height="45"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="В обработке"/>
                    <ComboBoxItem Content="Передан в доставку"/>
                    <ComboBoxItem Content="Завершен"/>
                    <ComboBoxItem Content="Отменен"/>
                </ComboBox>

                <!-- ИЗМЕНИТЬ (Используем оранжевую кнопку) -->
                <Button Grid.Column="1"
                        Content="Изменить статус"
                        Style="{StaticResource WarningButtonStyle}"
                        Height="45"
                        Margin="15,0"
                        Click="UpdateStatusBt_Click"/>

                <!-- УДАЛИТЬ (Используем красную кнопку) -->
                <Button Grid.Column="2"
                        Content="Отменить заказ"
                        Style="{StaticResource DangerButtonStyle}"
                        Height="45"
                        Margin="15,0"
                        Click="DeleteBt_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>