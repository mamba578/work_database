<Application x:Class="AdminPanel_project.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdminPanel_project"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Базовый стиль для панелей/контейнеров -->
        <Style x:Key="MainPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="40"/>
        </Style>

        <!-- Стиль для заголовков -->
        <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2F3E4E"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Универсальный стиль для текстовых полей с закруглениями -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                      Margin="{TemplateBinding Padding}" 
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" 
                              Margin="{TemplateBinding Padding}" 
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Универсальный стиль для полей пароля с закруглениями -->
        <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                      Margin="{TemplateBinding Padding}" 
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для CheckBox -->
        <Style x:Key="DefaultCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#3E5066"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Главная кнопка с закруглениями -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#6F8AA6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Эффект тени для карточек -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" Color="#CCCCCC" ShadowDepth="2" Opacity="0.5"/>

        <!-- Цветовые варианты кнопок (наследуют форму от PrimaryButtonStyle) -->
        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#F0AD4E"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#D9534F"/>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Background" Value="#57718A"/>
            <!-- Слегка темнее фона сайдбара -->
        </Style>

        <!-- Стили для текстов и заголовков -->
        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,20,0,40"/>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ==== СТИЛИ ДЛЯ КАРТОЧКИ ТОВАРА ==== -->

        <!-- Сама карточка (Border) -->
        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="280"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Бейдж статуса -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#E2E7ED"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>

        <!-- Заголовок и данные товара -->
        <Style x:Key="ProductTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="ProductStockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="ProductDetailStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#95A5A6"/>
        </Style>

        <Style x:Key="ProductPriceStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#27AE60"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Контейнер для окон с формами -->
        <Style x:Key="FormContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Padding" Value="30"/>
        </Style>

        <!-- Заголовок формы (наследуем от базового заголовка, меняем выравнивание и отступ) -->
        <Style x:Key="FormTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource HeaderTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
        </Style>

        <!-- Стиль для подписей (лейблов) над полями ввода -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="5,20,0,5"/>
            <Setter Property="Foreground" Value="#2F3E4E"/>
        </Style>

        <!-- Стиль для полей ввода в формах (наследует скругления, но меняет высоту) -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- Базовый стиль для выпадающих списков -->
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Контейнер для области загрузки изображения -->
        <Style x:Key="ImageUploadContainerStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D4DBE3"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- ==== СТИЛИ ДЛЯ АНАЛИТИКИ И ДАШБОРДОВ ==== -->

        <!-- Верхняя цветная панель (Баннер) -->
        <Style x:Key="BannerBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#6F8AA6"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="20"/>
        </Style>

        <!-- Заголовок внутри цветного баннера -->
        <Style x:Key="BannerTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="25,0,0,0"/>
        </Style>

        <!-- Инвертированная кнопка (белая на цветном фоне) с сильным скруглением -->
        <Style x:Key="InvertedRoundedButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#6F8AA6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Контейнер для графиков -->
        <Style x:Key="ChartContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Заголовок графика -->
        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="DockPanel.Dock" Value="Top"/>
        </Style>

        <!-- ==== СТИЛИ ДЛЯ ТАБЛИЦ И ПАНЕЛЕЙ УПРАВЛЕНИЯ ==== -->

        <!-- Нижняя панель с кнопками действий -->
        <Style x:Key="BottomActionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Margin" Value="20,10,20,0"/>
        </Style>

        <!-- ==== СТИЛИ ДЛЯ ТАБЛИЦ И ПАНЕЛЕЙ УПРАВЛЕНИЯ ==== -->

        <!-- Стиль заголовков колонок -->
        <Style x:Key="StandardDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2F5"/>
            <Setter Property="Foreground" Value="#2F3E4E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#D4DBE3"/>
        </Style>

        <!-- Стиль ячеек -->
        <Style x:Key="StandardDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2EBF4"/>
                    <Setter Property="Foreground" Value="#2F3E4E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль строк -->
        <Style x:Key="StandardDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Базовый стиль для таблиц DataGrid -->
        <Style x:Key="StandardDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FDFDFD"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- Привязка внутренних стилей -->
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource StandardDataGridHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource StandardDataGridCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource StandardDataGridRowStyle}"/>
        </Style>

        <!-- Динамический бейдж статуса (наследует форму от StatusBadgeStyle) -->
        <Style x:Key="DynamicStatusBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Активен">
                    <Setter Property="Background" Value="#D4EDDA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Удален">
                    <Setter Property="Background" Value="#F8D7DA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Динамический текст статуса (наследует шрифт от StatusTextStyle) -->
        <Style x:Key="DynamicStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Активен">
                    <Setter Property="Foreground" Value="#155724"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Удален">
                    <Setter Property="Foreground" Value="#721C24"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
